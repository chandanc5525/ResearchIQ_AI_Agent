# ResearchIQ local configuration
# Copy this file to .env and adjust values as needed. All services are local.

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
# qwen3:4b spends many tokens on internal reasoning before its answer.
OLLAMA_NUM_PREDICT=2000
# CPU inference is slow; allow a full multi-minute generation to finish.
OLLAMA_TIMEOUT=600

# --- Embeddings (local Hugging Face model) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=50

# --- Retrieval ---
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.0
MAX_CONTEXT_CHUNKS=12

# --- Workflow ---
MAX_VALIDATION_ITERATIONS=2
LOG_LEVEL=INFO

# --- Storage (optional overrides; defaults are project-relative) ---
# DATA_DIR=./data
# VECTORSTORE_DIR=./vectorstore

# --- LangSmith (optional; leave disabled for fully local operation) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ResearchIQ
